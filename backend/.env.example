DATABASE_URL="mysql://root:password@localhost:3306/farmdirect"
JWT_SECRET="change-this-secret-in-production"
JWT_EXPIRES_IN="7d"
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-frontend-domain.com

# Payment Provider (mock | razorpay)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMS Provider (mock | msg91 | twilio)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=FARMDIRECT
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Voice/IVR Provider (mock | exotel | twilio)
VOICE_PROVIDER=exotel
EXOTEL_SID=
EXOTEL_TOKEN=
EXOTEL_FROM=

# Image Storage (local | cloudinary | s3)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
