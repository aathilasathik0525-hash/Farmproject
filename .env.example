# FarmDirect Environment Configuration Template

# Server Port & Env
PORT=5000
NODE_ENV=development

# Database Connection (MySQL default)
DATABASE_URL="mysql://root:password@localhost:3306/farmdirect"

# Authentication
JWT_SECRET="farmdirect-dev-secret-super-secure-key-change-in-production-2024"
JWT_EXPIRES_IN="7d"

# Service Providers Configuration
SMS_PROVIDER="mock"         # options: mock, msg91, twilio
VOICE_PROVIDER="mock"       # options: mock, exotel, twilio
PAYMENT_PROVIDER="mock"     # options: mock, razorpay
STORAGE_PROVIDER="local"    # options: local, cloudinary, s3

# Optional Third-Party Keys
# MSG91_AUTH_KEY=""
# EXOTEL_SID=""
# EXOTEL_TOKEN=""
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
